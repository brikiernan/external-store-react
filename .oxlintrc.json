{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn"
  },
  "overrides": [
    {
      "files": ["apps/**/*.tsx"],
      "rules": {
        "react/only-export-components": [
          "warn",
          { "allowConstantExport": true }
        ]
      }
    }
  ],
  "ignorePatterns": ["**/dist/**"]
}
